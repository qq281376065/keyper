node_modules/
dist/
dist-electron/
release/
build/icons/
*.local
*.log
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
node_modules/.tmp/

# 便携模式的本地配置与日志（开发态落在项目根目录）
# 里面含加密后的连接凭据，绝不能提交
config/

# 历史构建产物（electron-builder 旧输出目录）
out-build/
out4/
out5/
release-build/
release-cfg/
release-ssh/

# 开发期的截图与临时探针产物（不属于源码）
.qa/
hero-*.png
previews/
nul
docs/_head.md
docs/_tail.md
*.full.png

# 设计稿（方案预览页）：本地迭代频繁、体积大，不进版本库
design/

# 官网站点（site/）随 main 发布到 GitHub Pages，站点文件与校验/预览脚本入库

# 从标签附注生成的发版说明，不入库。electron-builder 两处都要读：
# 根目录那份 → GitHub Release 正文；build/ 那份 → latest.yml 的 releaseNotes。
# 这条模式不带斜杠，因此同时覆盖两个位置。
release-notes.md

# 开发期脚本整体不入库：探针、复现、测量脚本都在这里。
# 注意 scripts/ 下已有 41 个入库文件（含 build 与 CI 调用的 csp-hash.mjs、
# i18n-check.mjs、inject-scope.mjs）——已跟踪文件不受本条影响，
# 但以后新增的要保留的脚本必须 `git add -f scripts/xxx.mjs` 显式加入。
# 例外：站点校验与本地预览脚本随站点一起入库。
scripts/*
!scripts/site-check.mjs
!scripts/serve-site.mjs

# 根目录的崩溃转储与量测产物
xargs.exe.stackdump
card-layers-*.png
