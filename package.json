{
  "name": "keyper",
  "productName": "Keyper",
  "version": "1.0.7",
  "description": "多引擎键值缓存管理工具 —— 基于 Electron + React + TypeScript 的跨平台 Redis / Memcached 客户端",
  "author": {
    "name": "Keyper"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "config": {
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "preview": "vite preview --port 4173",
    "preview:title": "vite --mode web --open /preview-title.html",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:alt": "npm run build && electron-builder --win -c.directories.output=release/${npm_package_version}-final",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "cn": "^0.5.0",
    "ioredis": "^5.4.1",
    "motion": "^14.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-measure": "^2.1.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "geist": "^1.8.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.63.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.7"
  }
}
